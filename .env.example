# Пример переменных окружения. Скопируйте в .env (локально) или задайте в Render.
# ВАЖНО: SUPABASE_URL указывается БЕЗ пути /rest/v1 — иначе все запросы к БД падают.

SUPABASE_URL=https://your-project.supabase.co
# secret-ключ Supabase (service role). Только на сервере, никогда в браузере.
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

FINNHUB_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Ключ подписи сессий. Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

PORT=4000
NODE_ENV=production
# Стоимость bcrypt: 10–12. Выше — безопаснее, но медленнее логин.
BCRYPT_ROUNDS=11
# Срок жизни сессии в днях
SESSION_DAYS=30
# Отключить поток Finnhub (например, если тариф упирается в 429)
ENABLE_FINNHUB_WS=true
LOG_LEVEL=info
